{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build && node scripts/finalize-third-party-licenses.mjs dist && node scripts/check-third-party-licenses.mjs dist",
    "build:package": "tsc && vp build --outDir ../src/cayu/server/dashboard --emptyOutDir && node scripts/finalize-third-party-licenses.mjs ../src/cayu/server/dashboard && node scripts/check-third-party-licenses.mjs ../src/cayu/server/dashboard",
    "build:parts": "node scripts/pack-parts.mjs",
    "preview": "vp preview",
    "generate:api": "node scripts/run-python.mjs scripts/generate-api-types.py",
    "generate:api:repo": "node scripts/run-python.mjs --repository scripts/generate-api-types.py",
    "check:api": "node scripts/run-python.mjs scripts/generate-api-types.py --check",
    "check:api:repo": "node scripts/run-python.mjs --repository scripts/generate-api-types.py --check",
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test run",
    "test:prototype": "CAYU_PROTOTYPE=1 vp build && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.13",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1",
    "vite-plus": "1.0.0-rc.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "seroval": "1.7.9",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1"
  }
}
