    },
    "ToolCallGrantMatcher": {
      "additionalProperties": false,
      "description": "Authorize a class of calls to one tool, optionally pinning exact values.\n\nEach pinned argument path must equal the value it had on the originating\napproval (type-strict JSON equality). Values come from the runtime's pending\nsnapshot, never from the client that creates the grant.",
      "properties": {
        "kind": {
          "const": "tool_call",
          "default": "tool_call",
          "title": "Kind",
          "type": "string"
        },
        "pinned_arguments": {
          "additionalProperties": true,
          "title": "Pinned Arguments",
          "type": "object"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "title": "ToolCallGrantMatcher",
      "type": "object"
    },
    "ValidationError": {
