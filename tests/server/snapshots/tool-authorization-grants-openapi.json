        "type"
      ],
      "title": "ValidationError",
      "type": "object"
    }
  },
  "paths": {
    "/api/tool-authorization-grants": {
      "get": {
        "operation_id": "list_grants_api_tool_authorization_grants_get",
        "parameters": [
          {
            "in": "query",
            "name": "after_created_at",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After Created At"
            }
          },
          {
            "in": "query",
            "name": "after_grant_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After Grant Id"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "origin_session_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Origin Session Id"
            }
          },
